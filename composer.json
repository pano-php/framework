{
  "name": "pano-php/framework",
  "description": "A lightweight PHP Nano Framework - Minimal execution foundation with full developer control",
  "type": "library",
  "license": "MIT",
  "keywords": ["php", "framework", "nano-framework", "minimal", "lightweight", "pano-framework"],
  "authors": [
    {
      "name": "alia_mehr",
      "email": "alia_mehr@yahoo.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Pano\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
